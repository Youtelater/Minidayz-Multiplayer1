import json
import re

# Load your original data.js file
with open("data.js", "r", encoding="utf-8") as f:
    content = f.read()

# Dictionary to hold everything we extract
extracted_data = {
    "audio_files": [],
    "sample_coordinates": [],
    "map_grid": [] # New section for full map data
}

# 1. Extract audio file names (matches .ogg and .m4a references)
audio_matches = re.findall(r'["\']([^"\']+\.(?:ogg|m4a))["\']', content)
extracted_data["audio_files"] = list(set(audio_matches))

# 2. Search for map layout arrays or generation grids in the obfuscated code
# (Depending on Construct 2's structure, look for large number arrays or specific map variables)
# Example pattern looking for coordinate-like rows or grid arrays:
grid_matches = re.findall(r'\[\s*(?:\d+,\s*)*\d+\s*\]', content)
if grid_matches:
    extracted_data["map_grid"] = grid_matches[:100] # Grab initial grid samples to inspect

# Save out to your unified JSON file
with open("extracted_audio_and_coords.json", "w", encoding="utf-8") as out:
    json.dump(extracted_data, out, indent=4)

print("Extraction complete! Check extracted_audio_and_coords.json for your new map grid data.")
