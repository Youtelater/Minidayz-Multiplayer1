import json
import re

with open("data.js", "r", encoding="utf-8") as f:
    content = f.read()

extracted_data = {
    "audio_files": [],
    "sample_coordinates": [],
    "map_grid": []
}

# 1. Extract audio file names
audio_matches = re.findall(r'["\']([^"\']+\.(?:ogg|m4a))["\']', content)
extracted_data["audio_files"] = list(set(audio_matches))

# 2. Extract and parse coordinate pairs more cleanly
# Look for instances containing pairs of numbers that look like coordinates
raw_coords = re.findall(r'([\d.]+)\s*,\s*([\d.]+)', content)

# Take a clean subset of valid coordinate pairs (filtering out extreme high-precision IDs if needed)
for x_str, y_str in raw_coords[:500]: # Grab first 500 points to test
    try:
        x_val = float(x_str)
        y_val = float(y_str)
        # Keep values within a reasonable map bounds range if necessary
        if 0 < x_val < 5000 and 0 < y_val < 5000:
            extracted_data["sample_coordinates"].append([x_val, y_val])
    except ValueError:
        continue

with open("extracted_audio_and_coords.json", "w", encoding="utf-8") as out:
    json.dump(extracted_data, out, indent=4)

print("Cleaned coordinate extraction complete!")