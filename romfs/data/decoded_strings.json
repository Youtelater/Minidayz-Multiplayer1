    "textContent",
    "{position:fixed;inset:0;z-index:100000;display:flex;align-items:center;",
    "justify-content:center;padding:18px;background:rgba(0,0,0,.78);",
    "font-family:Arial,'Segoe UI',sans-serif;color:#e8e4d8;user-select:none;}",
    " *{box-sizing:border-box;}",
    " .mpShell{width:min(980px,97vw);height:min(650px,94vh);display:grid;",
    "grid-template-rows:70px 1fr 68px;overflow:hidden;position:relative;",
    "background:linear-gradient(rgba(21,19,17,.89),rgba(11,12,12,.96)),",
    "url('images/options_menu-sheet0.png') center/100% 100% no-repeat;",
    "border:1px solid #6f6250;box-shadow:0 0 0 2px #171411,0 22px 80px #000;}",
    " .mpShell:before{content:'';position:absolute;inset:7px;pointer-events:none;",
    "border:1px solid rgba(178,154,118,.16);}",
    " .mpHead{display:flex;align-items:center;padding:0 24px;position:relative;",
    "border-bottom:1px solid rgba(190,174,145,.22);background:rgba(8,8,8,.55);}",
    " .mpTitle{font:normal 26px Georgia,'Times New Roman',serif;",
    "letter-spacing:2px;text-shadow:0 2px 2px #000;}",
    " .mpSessionTag{margin-left:14px;border:1px solid #574d41;color:#9a9285;",
    "font-size:9px;letter-spacing:2px;padding:4px 7px;text-transform:uppercase;}",
    " .mpSessionTag.live{border-color:#3f7a45;color:#8fd39a;}",
    " .mpClose{margin-left:auto;width:38px;height:38px;border:1px solid #574d41;",
    "background:rgba(0,0,0,.35);color:#bdb5a5;font-size:25px;cursor:pointer;}",
    " .mpClose:hover{color:#fff;border-color:#9d3b35;background:#491b19;}",
    " .mpMain{display:grid;grid-template-columns:200px 1fr;min-height:0;}",
    " .mpTabs{padding:18px 14px;border-right:1px solid rgba(190,174,145,.2);",
    "background:rgba(0,0,0,.3);display:flex;flex-direction:column;gap:9px;}",
    " .mpTab{min-height:49px;border:0;color:#c4bdaf;cursor:pointer;text-align:left;",
    "padding:0 17px;font:18px Georgia,'Times New Roman',serif;text-shadow:0 2px #000;",
    "background:linear-gradient(rgba(0,0,0,.13),rgba(0,0,0,.35)),",
    "url('images/menu_btn_wood-sheet0.png') left top/160% auto no-repeat;",
    "box-shadow:inset 0 0 0 1px rgba(155,125,89,.3);}",
    " .mpTab:hover{color:#fff;filter:brightness(1.18);}",
    " .mpTab.on{color:#fff;box-shadow:inset 4px 0 #a9322e,",
    "inset 0 0 0 1px rgba(190,151,102,.6);filter:brightness(1.2);}",
    " .mpTab small{display:block;margin-top:3px;color:#746d62;",
    "font:9px Arial,sans-serif;letter-spacing:1.2px;text-transform:uppercase;}",
    " .mpContent{overflow:auto;padding:22px 26px 28px;}",
    " .mpContent::-webkit-scrollbar{width:8px;}",
    " .mpContent::-webkit-scrollbar-track{background:#0b0b0b;}",
    " .mpContent::-webkit-scrollbar-thumb{background:#51493e;}",
    " .mpPage{display:none;animation:mpMenuIn .14s ease-out;}",
    " .mpPage.on{display:block;}",
    "@keyframes mpMenuIn{from{opacity:.25;transform:translateY(3px)}to{opacity:1;transform:none}}",
    " .mpPageTitle{margin:0 0 5px;font:23px Georgia,'Times New Roman',serif;}",
    " .mpIntro{margin:0 0 22px;color:#827c72;font-size:12px;line-height:1.5;}",
    " .mpSection{margin:0 0 22px;}",
    " .mpSectionTitle{display:flex;align-items:center;gap:10px;margin-bottom:12px;",
    "color:#a7a094;font-size:10px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;}",
    " .mpSectionTitle:after{content:'';height:1px;flex:1;background:rgba(190,174,145,.18);}",
    " .mpGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 16px;}",
    " .mpField,#",
    " .mpSwitchRow{min-height:58px;padding:9px 11px;",
    "background:rgba(0,0,0,.34);border:1px solid rgba(164,148,121,.2);}",
    " .mpLabel{display:flex;align-items:center;gap:8px;margin-bottom:6px;color:#8d877c;font-size:9px;",
    "font-weight:bold;letter-spacing:1.5px;text-transform:uppercase;}",
    " input[type=text],#",
    " input[type=number],",
    " select{width:100%;height:25px;border:0;border-bottom:1px solid #5d5549;",
    "border-radius:0;outline:0;background:transparent;color:#e8e4d8;font:14px Georgia,serif;}",
    " select{background:#191816;cursor:pointer;}",
    " input:focus,#",
    " select:focus{border-color:#a7332f;}",
    " .mpSegment{display:flex;height:30px;border:1px solid #50493f;}",
    " .mpSegment button{flex:1;border:0;border-right:1px solid #50493f;",
    "background:#171716;color:#827d74;font-size:10px;text-transform:uppercase;cursor:pointer;}",
    " .mpSegment button:last-child{border-right:0;}",
    " .mpSegment button.on{color:#fff;background:#672521;",
    "box-shadow:inset 0 -2px #b94b43;}",
    " .mpSwitchRow{display:flex;align-items:center;gap:12px;cursor:pointer;}",
    " .mpSwitchCopy{min-width:0;flex:1;}",
    " .mpSwitchCopy .mpLabel{margin:0;color:#bdb6aa;}",
    " .mpHint{margin-top:4px;color:#69645c;font-size:10px;line-height:1.25;}",
    " .mpSwitch{width:42px;height:22px;position:relative;flex:none;",
    "border:1px solid #514a40;background:#171716;}",
    " .mpSwitch:before{content:'';position:absolute;left:3px;top:3px;",
    "width:14px;height:14px;background:#716b62;transition:left .12s,background .12s;}",
    " .mpSwitch.on{border-color:#81342f;background:#351716;}",
    " .mpSwitch.on:before{left:23px;background:#b43c36;}",
    " .mpStepper{display:grid;grid-template-columns:34px 1fr 34px;height:30px;}",
    " .mpStepper button{border:1px solid #50493f;background:#211f1c;color:#bbb;cursor:pointer;}",
    " .mpStepper output{display:flex;align-items:center;justify-content:center;",
    "border-top:1px solid #50493f;border-bottom:1px solid #50493f;font:15px Georgia,serif;}",
    " .mpNote{margin:8px 0 0;color:#827c72;font-size:11px;line-height:1.5;}",
    " .mpNote.wide{grid-column:1/-1;}",
    " .mpField.wide{grid-column:1/-1;}",
    " .mpServerList{border:1px solid #3d3730;background:#111010;min-height:120px;}",
    " .mpServerRow{display:grid;grid-template-columns:1fr 90px 70px;gap:8px;padding:6px 10px;",
    "font-size:11px;color:#c4bdaf;}",
    " .mpServerRow.head{color:#8d877c;font-size:9px;font-weight:bold;letter-spacing:1.5px;",
    "text-transform:uppercase;border-bottom:1px solid #3d3730;}",
    " .mpServerEmpty{padding:26px 10px;text-align:center;color:#69645c;font-size:11px;}",
    " .mpServerRow.pick{cursor:pointer;border-bottom:1px solid rgba(61,55,48,.6);}",
    " .mpServerRow.pick:hover{background:#1d1a17;color:#fff;}",
    " .mpSlotBar.wide,#",
    " .mpSlotList.wide,#",
    " .mpHint.wide{grid-column:1/-1;}",
    " .mpSlotBar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;}",
    " .mpSlotBar input[type=text]{flex:1 1 180px;height:28px;margin-top:8px;padding:0 8px;background:#15130f;border:1px solid #50493f;color:#ddd;}",
    " .mpSlotList{display:flex;flex-direction:column;gap:6px;max-height:260px;overflow-y:auto;}",
    " .mpSlotRow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:6px 10px;border:1px solid rgba(61,55,48,.8);background:#1a1815;}",
    " .mpSlotName{color:#e8e2d6;font-size:12px;font-weight:bold;}",
    " .mpSlotTag{margin-left:8px;padding:1px 6px;border:1px solid #6a5f4b;color:#b9a77f;font-size:9px;letter-spacing:1px;}",
    " .mpSlotActs{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;}",
    " .mpSlotActs .mpRefresh{margin-top:0;}",
    " .mpDanger{color:#e0907f!important;border-color:#7a3a30!important;}",
    " .mpLinkField{width:100%;margin-top:6px;height:28px;padding:0 8px;background:#15130f;border:1px solid #50493f;color:#e8e2d6;font-size:11px;box-sizing:border-box;}",
    " .mpSlotBar input[type=text]{flex:1 1 180px;}",
    " .mpRefresh{margin-top:8px;height:28px;padding:0 14px;border:1px solid #50493f;",
    "background:#211f1c;color:#bbb;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;}",
    " .mpSoon{opacity:.42;}",
    " .mpSoon,#",
    " .mpSoon *{cursor:not-allowed!important;}",
    " .mpSoon input,#",
    " .mpSoon select,#",
    " .mpSoon button,",
    " .mpSoon .mpSwitch,#",
    " .mpSoon output{pointer-events:none;}",
    " .mpSoonTag{border:1px solid #6b5546;color:#b08a78;font-size:8px;letter-spacing:1.5px;",
    "padding:1px 5px;line-height:1.4;font-weight:bold;}",
    " .mpFoot{position:relative;display:flex;align-items:center;gap:14px;padding:0 24px;",
    "border-top:1px solid rgba(190,174,145,.22);background:rgba(8,8,8,.66);}",
    " .mpStatus{flex:1;color:#777168;font-size:10px;letter-spacing:1px;",
    "text-transform:uppercase;}",
    " .mpReset{border:0;background:transparent;color:#777168;cursor:pointer;",
    "font-size:11px;letter-spacing:1px;text-transform:uppercase;}",
    " .mpReset:hover{color:#ddd;}",
    " .mpCreate{height:42px;min-width:190px;border:1px solid #8e3a34;",
    "background:linear-gradient(#7c2d29,#491a18);color:#f7eee6;cursor:pointer;",
    "font:18px Georgia,'Times New Roman',serif;letter-spacing:1px;text-shadow:0 2px #260908;}",
    " .mpCreate:hover{background:linear-gradient(#984039,#5c211e);}",
    " .mpCreate.leave{border-color:#4d5a63;background:linear-gradient(#2c3a44,#16202a);}",
    " .mpToast{position:absolute;left:50%;bottom:78px;transform:translateX(-50%);",
    "padding:10px 16px;background:#140d0c;border:1px solid #8e3a34;color:#d6c4b8;",
    "font-size:11px;letter-spacing:1px;text-transform:uppercase;opacity:0;pointer-events:none;",
    "transition:opacity .15s;box-shadow:0 5px 25px #000;}",
    " .mpToast.show{opacity:1;}",
    "@media(max-width:720px){",
    "{padding:6px;}",
    " .mpShell{height:98vh;}",
    " .mpMain{grid-template-columns:1fr;grid-template-rows:auto 1fr;}",
    " .mpTabs{padding:8px;display:grid;grid-template-columns:repeat(5,1fr);",
    "border-right:0;border-bottom:1px solid rgba(190,174,145,.2);}",
    " .mpTab{min-height:39px;padding:0 6px;text-align:center;font-size:13px;}",
    " .mpTab small{display:none;}",
    " .mpContent{padding:15px;}",
    " .mpGrid{grid-template-columns:1fr;}",
    " .mpHead{padding:0 15px;}",
    " .mpFoot{padding:0 12px;}",
    " .mpCreate{min-width:145px;font-size:15px;}}",
    "@media(max-height:560px){",
    "{padding:6px;}",
    " .mpShell{height:98vh;grid-template-rows:48px 1fr 50px;}",
    " .mpHead{padding:0 16px;}",
    " .mpTitle{font-size:19px;letter-spacing:1px;}",
    " .mpTabs{padding:8px;gap:5px;}",
    " .mpTab{min-height:32px;font-size:14px;}",
    " .mpTab small{display:none;}",
    " .mpContent{padding:12px 16px 16px;}",
    " .mpIntro{margin-bottom:12px;}",
    " .mpSection{margin-bottom:14px;}",
    " .mpField,#",
    " .mpSwitchRow{min-height:0;padding:7px 9px;}",
    " .mpFoot{padding:0 14px;}",
    " .mpCreate{height:34px;min-width:150px;font-size:15px;}}",
    "@media(max-height:560px) and (max-width:720px){",
    " .mpMain{grid-template-columns:1fr;grid-template-rows:auto 1fr;}",
    " .mpTabs{grid-template-columns:repeat(5,1fr);border-right:0;",
    "border-bottom:1px solid rgba(190,174,145,.2);}",
    " .mpGrid{grid-template-columns:1fr;}}",
