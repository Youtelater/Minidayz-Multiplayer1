import os
import subprocess
import sys

gfx_dir = os.path.abspath("gfx")
build_dir = os.path.abspath("build")

if not os.path.exists(build_dir):
    os.makedirs(build_dir)

if not os.path.exists(gfx_dir):
    print(f"Error: {gfx_dir} does not exist.")
    sys.exit(1)

png_files = [f for f in os.listdir(gfx_dir) if f.endswith(".png")]
print(f"Found {len(png_files)} PNG files to process...")

for file in png_files:
    raw_name = os.path.splitext(file)[0]
    target_name = raw_name.replace("-", "_")
    
    src_path = os.path.join(gfx_dir, file)
    grit_config = os.path.join(gfx_dir, f"{raw_name}.grit")
    
    out_o = os.path.join(build_dir, f"{target_name}.o")
    out_h = os.path.join(build_dir, f"{target_name}.h")

    # Skip conversion if output already exists and is newer than source
    if os.path.exists(out_o) and os.path.getmtime(out_o) > os.path.getmtime(src_path):
        continue

    cmd = ["grit", src_path]
    if os.path.exists(grit_config):
        cmd.extend(["-ff", grit_config])
    else:
        cmd.extend(["-gt", "-gB16"])
    
    cmd.extend(["-s", target_name, "-o", os.path.join(build_dir, target_name)])

    subprocess.run(cmd, check=True)

    # Clean up any residual hyphenated files generated by grit
    generated_o = os.path.join(build_dir, f"{raw_name}.o")
    if os.path.exists(generated_o) and generated_o != out_o:
        os.replace(generated_o, out_o)

    generated_h = os.path.join(build_dir, f"{raw_name}.h")
    if os.path.exists(generated_h) and generated_h != out_h:
        os.replace(generated_h, out_h)

print("All graphics converted successfully!")
