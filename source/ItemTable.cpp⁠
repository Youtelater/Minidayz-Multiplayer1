    // 1. Initialize Item Table Mappings
    itemTable = {
        {1, "t37"},   {2, "t38"},   {3, "t195"},  {4, "t201"},  {5, "t202"},
        {6, "t32"},   {7, "t34"},   {8, "t46"},   {9, "t200"},  {10, "t68"},
        {11, "t30"},  {12, "t29"},  {13, "t31"},  {14, "t58"},  {15, "t57"},
        {16, "t59"},  {17, "t28"},  {18, "t35"},  {19, "t36"},  {20, "t264"},
        {301, "t87"}, // Taloon Backpack mapping
        {350, "t84"}, {400, "t65"}, {450, "t95"}, {700, "t1128"}
        // Add additional mappings as needed
    };

    // 2. Initialize Player Drop Table Mappings
    playerDropTable = {
        {64, "t71"},   {65, "t56"},   {118, "t1011"}, {119, "t1012"},
        {124, "t1017"},{125, "t1018"},{126, "t1027"}, {132, "t1080"},
        {703, "t1131"},{706, "t1173"},{707, "t1174"}, {714, "t1200"}
