std::string ItemTable::getTextureForItem(int itemId) {
    auto it = itemTable.find(itemId);
    if (it != itemTable.end()) {
        return it->second;
    }
    return ""; // Return empty string if ID not found
}

std::string ItemTable::getTextureForDrop(int dropId) {
    auto it = playerDropTable.find(dropId);
    if (it != playerDropTable.end()) {
        return it->second;
    }
    return "";
}

std::string ItemTable::getBaseVariantTexture(const std::string& variantId) {
    auto it = itemVariants.find(variantId);
    if (it != itemVariants.end()) {
        return it->second;
    }
    return variantId; // Return input if no variant mapping exists
}
