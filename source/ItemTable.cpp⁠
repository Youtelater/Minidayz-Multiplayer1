#include "ItemTable.h"
#include <fstream>
#include <nlohmann/json.hpp>

static std::unordered_map<std::string, std::string> g_itemTable;

void ItemTable_Load() {
    std::ifstream file("romfs:/data/player_data.json"); // Or your item JSON file path
    if (!file.is_open()) return;

    nlohmann::json j;
    file >> j;
    for (auto& [key, val] : j.items()) {
        if (val.is_string()) {
            g_itemTable[key] = val.get<std::string>();
        }
    }
}

std::string ItemTable_GetItemName(const std::string& itemId) {
    if (g_itemTable.count(itemId)) {
        return g_itemTable[itemId];
    }
    return "Unknown Item";
}